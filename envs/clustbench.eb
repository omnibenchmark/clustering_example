## eb --robot clustbench.eb --job-cores 120

easyblock = 'PythonBundle'

name = 'clustbench'
version = '1.1.6'

homepage = 'https://python.org/'
description = "clustering_benchmarks Python bundle."

toolchain = {'name': 'foss', 'version': '2024a'}


builddependencies = [
    ('pkgconf', '2.2.0'),
    ('Cython', '3.0.10'),
]


